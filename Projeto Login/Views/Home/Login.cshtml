@model Projeto_Login.Models.Cliente
@{
    ViewData["Title"] = "Login";
}

<main role="main">
    <br />
    <section class="container">
        <article class="col-md-4">
            <h1 class="subtitle-doc">
                Login
            </h1>
            <div id="code_login">
                <div class="card">
                    <article class="card-body">
                        @if (ViewData["MSG_E"] != null)
                        {
                            <p class="alert alert-danger">@Html.Raw(ViewData["MSG_E"])</p>
                        }

                        <a asp-action="Cadastrar" asp-controller="Cliente"
                           class="btn btn-primary btn-block">Seja Cliente</a>

                        <h4 class="card-title mt-3 text-center">Entrar</h4>

                        <form method="post">
                            <div class="form-group">
                                <label></label>
                                <input asp-for="Email" class="form-control" placeholder="Email" type="email">
                            </div>

                            <div class="form-group">
                                <a class="float-right" href="#">Esqueceu a senha?</a>
                                <label></label>
                                <input asp-for="Senha" class="form-control" placeholder="Senha" type="password">
                            </div>

                            <div class="form-group">
                                <button type="submit" class="btn btn-primary btn-block">Acessar</button>
                            </div>
                        </form>
                    </article>
                </div>
            </div>
        </article>
    </section>
</main>

